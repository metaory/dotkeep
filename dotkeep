function cmd::init {
  local dir=${1:-.}
  dir=${dir%/}
  mkdir -p "$dir/home" "$dir/root"
  [[ -e $dir/$DOTCONF ]] || : >"$dir/$DOTCONF"
  [[ -e $dir/.gitignore ]] || cat "$LIB/gitignore" >"$dir/.gitignore"
  [[ -d $dir/.git ]] || git -C "$dir" init -q
  ui::log ok init "$dir" "$dir/$DOTCONF"
  printf '\n'
  tree -aC -I '.git' -L 6 --noreport "$dir"
  printf '\n'
  help::guide_init "$dir"
}

function cmd::config {
  local f=$PWD/$DOTCONF
  [[ -f $f ]] || {
    help::main
    return
  }
  MANIFEST=$f
  help::config
  view::manifest "$f"
  help::syntax
  help::cmds
}

function cmd::check {
  local es=() e fs repo
  unset T
  declare -gA T=()
  conf::entries es
  while IFS=$'\t' read -r e fs repo; do
    ui::log step path "${c2}$fs"
    ui::log info keep "${c33}$e"
    [[ -L $fs ]] && {
      ui::log warn skip symlink
      tally symlink
      continue
    }
    [[ -e $fs ]] || {
      ui::log warn miss "${C3}missing on machine"
      tally miss
      continue
    }
    size::warn "$fs" "$e"
    [[ -e $repo ]] || {
      ui::log warn miss "${C3}missing in repo"
      tally miss
      continue
    }
    path::clash "$fs" "$repo" && {
      ui::log err type "type mismatch"
      tally clash
      continue
    }
    tally ok
  done < <(conf::pairs "${es[@]}")
  size::history
  tally::end check
  ((${T[clash]:-0})) || return 0
  exit 1
}

function cmd::sync {
  local es=()
  conf::entries es
  sync::run "$1" es
}

#  ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  ┃  INIT
#  ┗━━━━━━━━

trap 'ui::error "$?" "$LINENO" "$BASH_COMMAND"' ERR

cmd=${1:-help}
shift || true
case $cmd in
help | -h | --help)
  help::main
  exit
  ;;
init)
  cmd::init "$@"
  exit
  ;;
config)
  cmd::config
  exit
  ;;
check | backup | restore) ;;
*) ui::die "unknown command: $cmd (try: $NAME help)" ;;
esac

conf::discover

cfg=$(basename "$MANIFEST")

cd "$ROOT"
ROOT=.
MANIFEST=./$cfg

case $cmd in
check) cmd::check "$@" ;;
*) cmd::sync "$cmd" "$@" ;;
esac
