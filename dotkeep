#!/bin/bash
# shellcheck disable=SC2154,SC2034
set -Eeuo pipefail

NAME=dotkeep
DOTCONF=.$NAME.conf
ROOT=
MANIFEST=
UNREAD=0
DRY=0
# skip over this; DOTKEEP_MAX (MiB) raises it, capped at GitHub's 100 MiB
MAX=$((10 * 1024 * 1024))
PUSH=$((100 * 1024 * 1024))
readonly BEAT=2
# Du+w: a source dir without u+w must not make rsync skip every file in it
RSYNC=(rsync -rlptgo -c --no-owner --no-group --chmod=Du+w --exclude=.git --exclude=node_modules --exclude=__pycache__)
declare -A T=()

((BASH_VERSINFO[0] >= 5)) || {
  printf '%s: need bash 5+, found %s\n' "$NAME" "${BASH_VERSION:-?}" >&2
  exit 1
}

for bin in basename cat cmp curl dirname mkdir mktemp readlink realpath rsync sed sort tar tput tree; do
  command -v "$bin" >/dev/null && continue
  # curl/tar only needed for gum binary install; soft-warn later in gum::ensure
  [[ $bin == curl || $bin == tar ]] && continue
  printf '%s: missing command: %s\n' "$NAME" "$bin" >&2
  exit 1
done
# git optional: prep/ship/prune skipped when missing or no .git
command -v git >/dev/null || printf '%s: git not found (git features disabled)\n' "$NAME" >&2

SCRIPT=$(readlink -f "${BASH_SOURCE[0]}")
readonly LIB=${SCRIPT%/*}/lib

[[ -r $LIB/gum && -r $LIB/ui && -r $LIB/help && -r $LIB/path && -r $LIB/conf && -r $LIB/size && -r $LIB/git && -r $LIB/tally && -r $LIB/sync ]] || {
  printf '%s\n' "$NAME: incomplete installation: $LIB" >&2
  exit 1
}

# shellcheck source=lib/gum
source "$LIB/gum"
# shellcheck source=lib/ui
source "$LIB/ui"
# shellcheck source=lib/help
source "$LIB/help"
# shellcheck source=lib/path
source "$LIB/path"
# shellcheck source=lib/conf
source "$LIB/conf"
# shellcheck source=lib/size
source "$LIB/size"
# shellcheck source=lib/git
source "$LIB/git"
# shellcheck source=lib/tally
source "$LIB/tally"
# shellcheck source=lib/sync
source "$LIB/sync"

gum::ensure || {
  printf '%s: install gum (pacman -S gum) or see %s\n' "$NAME" "$GUM_REPO" >&2
  exit 1
}
gum::env

trap 'ui::error "$?" "$LINENO" "$BASH_COMMAND"' ERR

size::limit

[[ ${DOTKEEP_DRY-} == 1 ]] && DRY=1

cmd=${1:-help}
shift || true

case $cmd in
help | -h | --help)
  help::main
  exit 0
  ;;
init)
  cmd::init "$@"
  exit 0
  ;;
config)
  (($#)) && ui::die "unexpected arg: $1 (try: $NAME help)"
  cmd::config
  exit 0
  ;;
check | backup | restore)
  while (($#)); do
    case $1 in
    --dry-run)
      DRY=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -*) ui::die "unknown flag: $1 (try: $NAME help)" ;;
    *) ui::die "unexpected arg: $1 (flags after command, e.g. $NAME backup --dry-run)" ;;
    esac
  done
  ;;
*) ui::die "unknown command: $cmd (try: $NAME help)" ;;
esac

conf::discover

cfg=$(basename "$MANIFEST")
cd "$ROOT"
ROOT=.
MANIFEST=./$cfg

case $cmd in
check) cmd::check ;;
*)
  es=()
  conf::entries es
  sync::run "$cmd" es
  ;;
esac

# vim: ft=bash
