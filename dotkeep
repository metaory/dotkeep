#!/bin/bash
# shellcheck disable=SC2154
set -Eeuo pipefail

NAME=dotkeep
DOTCONF=.$NAME.conf
ROOT=
MANIFEST=
UNREAD=0
# tighter than GitHub's 100 MiB reject
MAX=$((10 * 1024 * 1024))
PUSH=$((100 * 1024 * 1024))
RSYNC=(rsync -rptgo --no-owner --no-group --exclude=.git)
declare -A T=()

((BASH_VERSINFO[0] >= 5)) || {
  printf '%s: need bash 5+, found %s\n' "$NAME" "${BASH_VERSION:-?}" >&2
  exit 1
}

for bin in basename cat dirname git mkdir mktemp readlink realpath rsync sed sort tput tree; do
  command -v "$bin" >/dev/null && continue
  printf '%s: missing command: %s\n' "$NAME" "$bin" >&2
  exit 1
done

SCRIPT=$(readlink -f "${BASH_SOURCE[0]}")
readonly LIB=${SCRIPT%/*}/lib

[[ -r $LIB/help ]] || {
  printf '%s\n' "$NAME: incomplete installation: $LIB/help" >&2
  exit 1
}

# shellcheck source=lib/help
source "$LIB/help"

# type → "prefix colorVar"
declare -A LOG=(
  [ok]='⇒ C2'
  [info]=':> c33'
  [warn]='!! C3'
  [err]='✗✗ C1'
  [step]='=> C6'
  [path]='·> C2'
)

#  ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  ┃  UI
#  ┗━━━━━━

function ui::nl { printf '\n'; }

function ui::palette {
  local i
  r=
  it=
  for i in {0..255}; do
    printf -v "c$i" ''
    printf -v "C$i" ''
  done
  [[ -t 1 && -z ${NO_COLOR:-} ]] || return 0
  for i in {1..255}; do
    printf -v "c$i" '\033[38;5;%sm' "$i"
    printf -v "C$i" '\033[38;5;%s;1m' "$i"
  done
  r=$'\033[0m'
  it=$'\033[3m'
}
ui::palette
readonly border_color=$c8

# ui::log TYPE TITLE [DETAIL...]
# DETAIL parts join with →
# empty TITLE skips the title column
function ui::log {
  local type=$1 title=${2-} spec pre cn fd=1
  shift 2 || true
  spec=${LOG[$type]-'·· c7'}
  pre=${spec%% *}
  cn=${spec##* }
  local -n col=$cn
  [[ $type == err ]] && fd=2
  {
    printf '%s%-2s%s' "$col" "$pre" "$r"
    [[ $title ]] && printf ' %s%-5s%s' "$col" "$title" "$r"
    (($#)) && printf '  %s%s' "$c7" "$1" && shift
    local x
    for x; do printf ' %s→%s %s%s' "$c7" "$r" "$c6" "$x"; done
    printf '%s\n' "$r"
  } >&"$fd"
}

function ui::divider {
  local colr="${1:-c5}"
  local char="${2:-─}"
  local word="${3:-}"
  local len="$(($(tput cols) - ${#word} - 2))"
  local left="$((len / 2))"
  local right="$((len - left))"
  colr="${!colr-}"
  printf '%*s %s %*s\n' "$left" '' "${c57-}$word${r}" "$right" '' |
    sed "s/ /${colr}$char/g"
}

function ui::fatal {
  local msg=$1 tip=${2-}
  ui::nl
  ui::divider c1 ━
  {
    [[ $c1 ]] && printf '\n  \033[48;5;197;38;5;16;1m ✗✗  %s \033[0m\n' "$msg"
    [[ $c1 ]] || printf '\n  ✗✗  %s \n' "$msg"
    [[ $tip ]] && printf '\n%s tip:%s  %s%s%s\n' "$c6" "$r" "$c3" "$tip" "$r"
  } >&2
  exit 1
}

function ui::die {
  ui::fatal "$*" "$NAME help"
}

function ui::error {
  local code=$1 line=$2 cmd=$3
  trap - ERR
  ui::fatal "command failed ($code): $cmd" "line $line"
}

function ui::paint {
  local line=${1%$'\r'}
  line=${line#"${line%%[![:space:]]*}"}
  line=${line%"${line##*[![:space:]]}"}
  case $line in
  home/*) printf '%s%s%s/%s%s' "$c2" home "$c6" "${line#home/}" "$border_color" ;;
  root/*) printf '%s%s%s/%s%s' "$c2" root "$c6" "${line#root/}" "$border_color" ;;
  '#'*) printf '%s%s' "${C60}" "$line$border_color" ;;
  '') printf '%s' "$border_color" ;;
  *) printf '%s%s' "$c7" "$line$border_color" ;;
  esac
}

#  ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  ┃  VIEW
#  ┗━━━━━━━━

# view::config TITLE LINE... — box render (help sample, config, backup/restore)
function view::config {
  local title=$1 line vis pad i top='' bot='' width dashes llen=0
  shift
  local -a lines=("$@") vises=()
  for line in "${lines[@]}"; do
    vis=${line%$'\r'}
    vis=${vis#"${vis%%[![:space:]]*}"}
    vis=${vis%"${vis##*[![:space:]]}"}
    vises+=("$vis")
    ((${#vis} > llen)) && llen=${#vis}
  done
  # title: ╭─ TITLE ─╮  → width = title + dashes + 5
  # body:  │ TEXT  … │  → TEXT+pad = width - 4
  dashes=1
  width=$((${#title} + dashes + 5))
  ((width < llen + 4)) && {
    width=$((llen + 4))
    dashes=$((width - ${#title} - 5))
  }
  for ((i = 0; i < dashes; i++)); do top+=━; done
  for ((i = 0; i < width - 2; i++)); do bot+=━; done
  printf '  %s┏━ %s%s%s %s┓%s\n' "$border_color" "$c1" "$title" "$border_color" "$top" "$r"
  for i in "${!lines[@]}"; do
    pad=$(printf '%*s' $((width - 4 - ${#vises[i]})) '')
    printf '  %s┃ %s%s ┃%s\n' "$border_color" "$(ui::paint "${lines[i]}")" "$pad" "$r"
  done
  printf '  %s┗%s┛%s\n' "$border_color" "$bot" "$r"
}

# view::manifest [TITLE] — load $MANIFEST into the shared box
function view::manifest {
  local title=${1:-$MANIFEST}
  local -a lines=()
  mapfile -t lines <"$MANIFEST"
  view::config "$title" "${lines[@]}"
}

#  ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  ┃  PATH
#  ┗━━━━━━━━

function path::trim {
  local s=${1%%#*}
  s=${s#"${s%%[![:space:]]*}"}
  printf '%s\n' "${s%"${s##*[![:space:]]}"}"
}

function path::norm {
  local IFS=/ p
  local -a out=()
  for p in $1; do
    case $p in
    '' | .) ;;
    ..)
      ((${#out[@]} > 1)) || return 1
      unset 'out[-1]'
      ;;
    *) out+=("$p") ;;
    esac
  done
  ((${#out[@]} >= 2)) || return 1
  [[ ${out[0]} == home || ${out[0]} == root ]] || return 1
  IFS=/
  printf '%s\n' "${out[*]}"
}

function path::resolve {
  case $1 in
  home/*) printf '%s/%s\n' "$HOME" "${1#home/}" ;;
  root/*) printf '/%s\n' "${1#root/}" ;;
  *) return 1 ;;
  esac
}

function path::canon {
  local n
  [[ $1 != *['$~']* ]] || ui::die "forbidden char in: $1"
  n=$(path::norm "$1") || ui::die "invalid path: $1"
  printf '%s\n' "$n"
}

# keep parents, drop children; order in manifest does not matter
function path::overlap {
  local -n _paths=$1
  local -a s=() keep=()
  ((${#_paths[@]} < 2)) && return 0
  mapfile -t s < <(printf '%s\n' "${_paths[@]}" | sort)
  local -A drop=()
  local p parent=
  for p in "${s[@]}"; do
    [[ $parent && $p == "$parent"/* ]] && {
      drop[$p]=$parent
      continue
    }
    parent=$p
  done
  ((${#drop[@]})) || return 0
  for p in "${_paths[@]}"; do
    [[ -v drop[$p] ]] && {
      ui::log warn drop "$p" "under ${drop[$p]}"
      continue
    }
    keep+=("$p")
  done
  _paths=("${keep[@]}")
}

function path::clash {
  [[ -e $1 && -e $2 ]] || return 1
  [[ (-d $1 && -f $2) || (-f $1 && -d $2) ]]
}

#  ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  ┃  CONF
#  ┗━━━━━━━━

function conf::discover {
  local f=$PWD/$DOTCONF
  [[ -f $f ]] || {
    help::main
    ui::fatal "no ./$DOTCONF" "$NAME init"
  }
  MANIFEST=$f
  ROOT=$(dirname "$f")
}

function conf::read {
  [[ -f $MANIFEST ]] || ui::die "missing manifest at $MANIFEST"
  local line
  while IFS= read -r line || [[ $line ]]; do
    line=$(path::trim "$line")
    if [[ $line ]]; then
      printf '%s\n' "$line"
    fi
  done <"$MANIFEST"
}

function conf::parse {
  local dest=$1
  local -n _out=$1
  local raw n
  local -A seen=()
  _out=()
  shift
  for raw; do
    if [[ -z $raw ]]; then
      continue
    fi
    n=$(path::canon "$raw")
    if [[ -v seen[$n] ]]; then
      continue
    fi
    seen[$n]=1
    _out+=("$n")
  done
  path::overlap "$dest"
}

function conf::entries {
  local -n _e=$1
  local -a raws=()
  mapfile -t raws < <(conf::read)
  conf::parse "$1" "${raws[@]}"
  ((${#_e[@]})) || {
    help::guide_empty
    ui::fatal "manifest is empty" "edit $MANIFEST  then  $NAME backup"
  }
}

function conf::pairs {
  local e
  for e; do printf '%s\t%s\t%s\n' "$e" "$(path::resolve "$e")" "$ROOT/$e"; done
}

#  ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  ┃  ASK
#  ┗━━━━━━━

function ask::tty { [[ -t 0 || -r /dev/tty ]] || echo FAIL; }

function ask::yn {
  local ans='' tty
  ask::tty
  exec {tty}<>/dev/tty
  printf '%s%s%s %s[y/N]%s ' "$c3" "$1" "$r" "$C2" "$r" >&"$tty"
  IFS= read -r -n 1 -u "$tty" ans || true
  printf '\n' >&"$tty"
  exec {tty}>&-
  case $ans in
  [yY]) return 0 ;;
  esac
  return 1
}

#  ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  ┃  TALLY
#  ┗━━━━━━━━

function tally { ((++T[$1])); }

function tally::add { ((T[$1] += $2)); }

function tally::why {
  case $1 in
  symlink) tally symlink ;;
  'not on machine' | 'not in repo') tally miss ;;
  'same path') tally same ;;
  'dest outside repo') tally outside ;;
  'type mismatch') tally clash ;;
  *) tally skip ;;
  esac
}

function tally::color {
  case $1 in
  ok) printf '%s' "$c2" ;;
  clash) printf '%s' "$c1" ;;
  *) printf '%s' "$C3" ;;
  esac
}

function tally::end {
  local cmd=$1 k n col tc=$c2
  local -a keys=() ns=()
  local kw=0 nw=0 i top='' bot='' dashes width llen pad kgap ngap
  for k in ok large skip some unreadable symlink miss clash same outside; do
    n=${T[$k]:-0}
    ((n)) || continue
    keys+=("$k")
    ns+=("$n")
    ((${#k} > kw)) && kw=${#k}
    ((${#n} > nw)) && nw=${#n}
  done
  ((${#keys[@]})) || {
    keys=(ok)
    ns=(0)
    kw=2
    nw=1
  }
  ((${T[clash]:-0})) && tc=$c1
  llen=$((kw + 2 + nw))
  dashes=1
  width=$((${#cmd} + dashes + 5))
  ((width < llen + 4)) && {
    width=$((llen + 4))
    dashes=$((width - ${#cmd} - 5))
  }
  for ((i = 0; i < dashes; i++)); do top+=━; done
  for ((i = 0; i < width - 2; i++)); do bot+=━; done
  ui::nl
  printf '  %s┏━ %s%s%s %s┓%s\n' "$border_color" "$tc" "$cmd" "$border_color" "$top" "$r"
  for i in "${!keys[@]}"; do
    k=${keys[i]}
    n=${ns[i]}
    col=$(tally::color "$k")
    pad=$(printf '%*s' $((width - 4 - llen)) '')
    kgap=$(printf '%*s' $((kw - ${#k})) '')
    ngap=$(printf '%*s' $((nw - ${#n})) '')
    printf "  %s┃ %s%s%s  %s%s%s%s%s ${border_color}┃%s\n" \
      "$border_color" "$col" "$k" "$kgap" "$col" "$ngap" "$n" "$pad" "$r"
  done
  printf '  %s┗%s┛%s\n' "$border_color" "$bot" "$r"
}

#  ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  ┃  SIZE
#  ┗━━━━━━━━

function size::mib {
  printf '%d.%02d MiB' $(($1 / 1048576)) $((($1 % 1048576) * 100 / 1048576))
}

# size::scan ROOT — bytes<TAB>path for regular files over MAX
function size::scan {
  local b p
  [[ -e $1 && ! -L $1 ]] || return 0
  find "$1" -type f -printf '%s\t%p\n' | while IFS=$'\t' read -r b p; do
    ((b <= MAX)) && continue
    printf '%s\t%s\n' "$b" "$p"
  done || :
}

# size::rows ROOT LABEL — bytes<TAB>display, label plus path under ROOT
function size::rows {
  local root=$1 label=$2 b p rel
  while IFS=$'\t' read -r b p; do
    rel=${p#"$root"}
    rel=${rel#/}
    [[ $rel ]] && rel="/$rel"
    printf '%s\t%s\n' "$b" "$label$rel"
  done < <(size::scan "$root")
}

function size::warn {
  local b p
  while IFS=$'\t' read -r b p; do
    ui::log warn size "$(size::mib "$b")" "$p"
    tally large
  done < <(size::rows "$@")
}

function size::history {
  local type sz oid path note
  [[ -d .git ]] || return 0
  git rev-list --objects --all 2>/dev/null |
    git cat-file --batch-check='%(objecttype) %(objectsize) %(objectname) %(rest)' |
    while read -r type sz oid path; do
      [[ $type == blob ]] || continue
      [[ $sz =~ ^[0-9]+$ ]] || continue
      ((sz > MAX)) || continue
      note='in history'
      ((sz > PUSH)) && note='in history, push will reject'
      ui::log warn size "$(size::mib "$sz")" "${path:-$oid}" "$note"
    done || :
}

# size::exclude SRC DST — drop repo leftovers; tally only ones preview missed
function size::exclude {
  local src=$1 dst=$2 b p rel removed=0
  local -A hit=()
  [[ -e $dst && ! -L $dst ]] || return 0
  while IFS=$'\t' read -r b p; do
    rel=${p#"$src"}
    rel=${rel#/}
    hit[${rel:-.}]=1
  done < <(size::scan "$src")
  while IFS=$'\t' read -r b p; do
    rel=${p#"$dst"}
    rel=${rel#/}
    rm -f -- "$p"
    ((++removed))
    [[ -v hit[${rel:-.}] ]] || tally large
  done < <(size::scan "$dst")
  ((removed)) || return 0
  ui::log warn size "dropped $removed" "over 10 MiB"
}

#  ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  ┃  SYNC
#  ┗━━━━━━━━

# sync  (order ≈ sync::run call chain)
function sync::ends {
  local side=$1 e=$2 fs=$3 repo=$4
  local -n _src=$5 _dst=$6 _from=$7 _to=$8
  case $side in
  backup)
    _src=$fs
    _dst=$repo
    _from=$fs
    _to=repo/$e
    ;;
  restore)
    _src=$repo
    _dst=$fs
    _from=repo/$e
    _to=$fs
    ;;
  esac
}

# sync::skip SRC DST SIDE WHY_NAMEREF — 0 = skip (sets why), 1 = usable
function sync::skip {
  local src=$1 dst=$2 side=$3
  local -n _why=$4
  [[ -L $src ]] && {
    _why=symlink
    return 0
  }
  [[ -e $src ]] || {
    case $side in
    backup) _why='not on machine' ;;
    restore) _why='not in repo' ;;
    esac
    return 0
  }
  [[ $(sync::canon "$src") != "$(sync::canon "$dst")" ]] || {
    _why='same path'
    return 0
  }
  [[ $side != backup ]] || sync::in_repo "$dst" || {
    _why='dest outside repo'
    return 0
  }
  path::clash "$src" "$dst" && {
    _why='type mismatch'
    return 0
  }
  return 1
}

function sync::preview {
  local side=$1
  shift
  local e fs repo src dst from to why n=0
  ui::nl
  case $side in
  backup) ui::log step backup "machine → repo ${c3}($# paths)" ;;
  restore)
    ui::log step restore "repo → machine ${c3}($# paths)"
    ui::log info 'saving backups' 'in' "${c3}/tmp/$NAME.XXXXXX/"
    ;;
  esac
  ui::nl
  while IFS=$'\t' read -r e fs repo; do
    sync::ends "$side" "$e" "$fs" "$repo" src dst from to
    why=
    sync::skip "$src" "$dst" "$side" why && {
      ui::log warn ' skip' "${c1}$why" "${c3}$from"
      continue
    }
    ((++n))
    case $side in
    backup)
      ui::log path '' "$from"
      size::warn "$src" "$e"
      ;;
    restore) ui::log info '' "$to" ;;
    esac
  done < <(conf::pairs "$@")
  [[ $side == backup ]] && size::history
  ui::nl
  ((n)) || ui::fatal "no valid sources" "fix $MANIFEST or create the missing paths"
}

# owned + unreadable cannot be copied; +r is enough and we leave it
function sync::readable {
  find "$1" -type f -uid "$UID" ! -readable -exec chmod u+r {} + 2>/dev/null || :
}

# paths rsync cannot open, relative to SRC, anchored
function sync::unreadable {
  [[ -d $1 ]] || return 0
  find "$1" -mindepth 1 \
    \( -type d \( ! -readable -o ! -executable \) -prune -printf '/%P\n' \) -o \
    \( -type f ! -readable -printf '/%P\n' \) \
    2>/dev/null || :
}

function sync::canon { realpath -m "$1"; }

# dest must stay inside the state repo even if a symlink points at /etc or $HOME
function sync::in_repo {
  local here to
  here=$(sync::canon .)
  to=$(sync::canon "$1")
  [[ $to == "$here"/home/* || $to == "$here"/root/* ]]
}

function sync::path {
  local src=$1 dst=$2 side=${3-} rc=0 err skip
  local -a extra=() lines=() opts=("${RSYNC[@]}")
  UNREAD=0
  [[ $side == restore ]] && opts+=(--delete)
  [[ $side == backup ]] && opts+=(--max-size="$MAX")
  mkdir -p "$(dirname "$dst")"
  sync::readable "$src"
  skip=$(sync::unreadable "$src")
  [[ $skip ]] && {
    mapfile -t lines <<<"$skip"
    extra=("${lines[@]/#/--exclude=}")
    UNREAD=${#lines[@]}
    ui::log warn some "$src" "$UNREAD unreadable"
  }
  if [[ -d $src ]]; then
    mkdir -p "$dst"
    err=$("${opts[@]}" "${extra[@]}" "$src/" "$dst/" 2>&1) || rc=$?
  else
    err=$("${opts[@]}" "${extra[@]}" "$src" "$dst" 2>&1) || rc=$?
  fi
  [[ $side == backup && (rc -eq 0 || rc -eq 23 || rc -eq 24) ]] && size::exclude "$src" "$dst"
  ((rc)) || return 0
  # 23 partial, 24 vanished mid-transfer
  ((rc == 23 || rc == 24)) && return 0
  [[ $err ]] && printf '%s\n' "$err" >&2
  return "$rc"
}

function sync::safety {
  ui::nl
  local -n _safe=$1
  local -n _bak=$2
  local -n _n=$3
  local e fs repo
  _bak=$(mktemp -d /tmp/"$NAME".XXXXXX)
  _n=0
  ui::log step backup "$_bak"
  while IFS=$'\t' read -r e fs repo; do
    [[ -L $fs || ! -e $fs ]] && continue
    path::clash "$fs" "$repo" && continue
    sync::path "$fs" "$_bak/$e"
    ui::log info bak "$_bak/$e"
    ((++_n))
  done < <(conf::pairs "${_safe[@]}")
  ((_n)) && ui::log ok backup "$_n paths" "$_bak"
  ((_n)) || ui::log warn safety "nothing on machine to bak"
  ui::nl
}

function sync::one {
  local side=$1 e=$2 fs=$3 repo=$4 src=$5 dst=$6 from=$7 to=$8
  case $side in
  backup) ui::log path '' "${c6}$from" ;;
  restore) ui::log info '' "${c2}$to" ;;
  esac
  sync::path "$src" "$dst" "$side"
}

function sync::prune {
  [[ -d .git ]] || return 0
  git clean -Xdfq -- home root
}

function sync::git {
  [[ -d .git ]] || return 0
  printf '\n'
  git -c color.status=always status -sb
  git rev-parse --verify HEAD >/dev/null 2>&1 || return 0
  printf '\n'
  git -c color.ui=always log --oneline --decorate -5
}

function sync::run {
  local side=$1
  local -n _es=$2
  local e fs repo src dst from to bak='' n=0 why
  unset T
  declare -gA T=()

  "help::$side"
  ui::nl
  view::manifest
  sync::preview "$side" "${_es[@]}"

  ask::yn " are you sure?" || ui::die "aborted"

  [[ $side != restore ]] || sync::safety "$2" bak n
  [[ $side != restore ]] || sync::prune

  while IFS=$'\t' read -r e fs repo; do
    sync::ends "$side" "$e" "$fs" "$repo" src dst from to
    why=
    sync::skip "$src" "$dst" "$side" why && {
      tally::why "$why"
      continue
    }
    sync::one "$side" "$e" "$fs" "$repo" "$src" "$dst" "$from" "$to"
    ((UNREAD)) && {
      tally some
      tally::add unreadable "$UNREAD"
      continue
    }
    tally ok
  done < <(conf::pairs "${_es[@]}")

  [[ $side != backup ]] || sync::prune
  tally::end "$side"
  ui::nl
  [[ $side != backup ]] || sync::git
  ui::nl
  if [[ $side == restore && n -gt 0 ]]; then
    ui::log info prior "$bak"
  fi
}

