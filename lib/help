# shellcheck shell=bash disable=SC2154

function help::intro {
  cat <<EOF
${C6} dotkeep ${c7}// ${c2}dotfiles, kept simple${r}

${it}${c7}  A single plain-text manifest for syncing configuration with Git${r}
${it}${c7}  install this binary; backups live in a separate repo${r}
EOF
  ui::divider c8 ─
}

function help::init {
  cat <<EOF
${C3}INIT${r}
${C2}  $NAME init${r} [DIR]
  Creates your ${it}state repo${r}: 
    ${c6}home/${r} ${c6}root/${r} + empty ${c6}$DOTCONF${r} + ${c6}.gitignore${r} + ${c6}git init${r}
  ${it}Pick any other dir, then add your own remote${r}

${it}  Or skip init: mkdir a dir and write ${c6}$DOTCONF${r} yourself${r}
${it}  Next: ${C2}cd${r} to that dir, ${c2}$NAME config${r}, then ${c2}$NAME backup${r}
EOF
  ui::divider c8 -
}

function help::config {
  cat <<EOF
${C3}CONFIG${r}
${C2}  $NAME ${c2}config${r}
  Prints the full path to ${c6}$DOTCONF${r} and its contents
  Then asks to open it with ${C4}\$EDITOR${r}

  Plain file. One path per line. ${c7}#${r} comments
  Every entry must start with ${C2}home/${r} or ${C2}root/${r}
  No ${c1}~${r}, no absolute ${c1}/${r} forms, no ${c1}\$VAR${r} expansion
  Prefer explicit files over whole dirs
  Unreadable files are skipped. The rest of the dir is copied
  Symlinks, nested ${c6}.git/${r} and ${c6}node_modules${r} stripped 
  ${c6}.gitignore${r} is respected

EOF
}

function help::sample {
  local -a samples=()
  mapfile -t samples <"${SCRIPT%/*}/dotkeep.conf.sample"
  view::config "$DOTCONF" "${samples[@]}"
}

function help::syntax {
  cat <<EOF
${c2}   home/.zshrc${r}       is  ${c3}\$HOME/.zshrc${r}
${c2}   root/etc/hosts${r}    is  ${c3}/etc/hosts${r}
EOF
  ui::divider c8 -
}

function help::howto {
  help::config
  help::sample
  help::syntax
}

function help::layout {
  cat <<EOF
${C3}WHERE${r}
${c2}  config${r} / ${c2}check${r} / ${c2}backup${r} / ${c2}restore${r} run inside ${it}your state dir${r}
${it}  (the dir that holds ${c6}$DOTCONF${r}). Not the tool install${r}
${it}  Any path, any remote, you choose${r}

    ${c2}state/${r}
    ${c6}├── ${c3}$DOTCONF${r}
    ${c6}├── ${c3}.gitignore${r}
    ${c6}├── home/${r}
    ${c6}└── root/${r}
EOF
  ui::divider c8 -
}

function help::backup {
  cat <<EOF
${C3}BACKUP${r}
${C2}  $NAME ${c2}backup${r}
  ${c6}1.${r} git prep ${it}(optional)${r}: fetch, status, ask pull if behind
  ${c6}2.${r} preview ${c3}machine → repo${r}, ask before write
  ${c6}3.${r} copy listed paths into ${c6}home/${r} ${c6}root/${r}
  ${c6}4.${r} prune ignored via ${c2}git clean -X${r}, rewrite ${c6}README.md${r} tree
  ${c6}5.${r} git ship ${it}(optional)${r}: ask add, commit, push
  Files over ${c1}$((MAX / 1048576)) MiB${r} skipped and warned
  ${C4}DOTKEEP_MAX${r} (MiB) ${c3}default 10${r}, ${c3}max 100${r}; above ${b}100${r} capped and warned
  GitHub rejects over ${c3}100 MiB${r} on push; committed blobs still fail
  ${it}${c3}Pull, add, commit, push are opt-in.${r} Default is no. No origin → no push

  ${C6}after yes on ship${r}
    ${c2}git add -A${r}
    ${c2}git commit -m${r} ${c7}snapshot YYYY-MM-DD HH:MM${r}
    ${c2}git push${r} ${c7}# if origin exists${r}
EOF
  ui::divider c8 -
}

function help::restore {
  cat <<EOF
${C3}RESTORE${r}
  ${C2}$NAME ${c2}restore${r}
  ${c6}1.${r} same git prep as backup ${it}(optional pull)${r}
  ${c6}2.${r} preview ${c3}repo → machine${r}, ask before write
  ${c6}3.${r} live targets → ${C2}/tmp/$NAME.XXXXXX/${r} first
  ${c6}4.${r} prune ignored in state, then copy ${it}(rsync --delete)${r}
  No commit or push on restore

  ${C6}new machine${r}
    ${c60}# clone your state repo${r}
    ${c2}git clone${r} ${c7}<url>${r} ${c6}<state-dir>${r}
    ${c60}# enter that clone${r}
    ${C2}cd${r} ${c6}<state-dir>${r}
    ${c60}# repo → machine${r}
    ${C2}$NAME restore${r}

  ${C6}existing clone${r}
    ${c60}# enter your state dir${r}
    ${C2}cd${r} ${c6}<state-dir>${r}
    ${c60}# fetch, then pull --rebase if behind. default no${r}
    ${C2}$NAME restore${r}
EOF
  ui::divider c8 -
}

function help::cmds {
  cat <<EOF
${C3}COMMANDS${r}
  ${C2}$NAME ${c2}<command>${r}

  ${c2}init${r} [DIR]   create ${it}state repo${r}, ${c6}home/ root/${r} + ${c6}$DOTCONF${r} + ${c6}git${r}
  ${c2}config${r}       show ${c6}$DOTCONF${r}, offer to edit
  ${c2}check${r}        validate + resolve paths
  ${c2}backup${r}       copy live files into the state repo
  ${c2}restore${r}      copy state repo files onto the live system
  ${c2}help${r}
EOF
  ui::divider c8 -
}

function help::env {
  cat <<EOF
${C3}ENV${r}
  ${C4}NO_COLOR${r}     disables color
  ${C4}EDITOR${r}       used by ${c2}config${r}, else ${c2}nvim${r} ${c2}vim${r} ${c2}vi${r}
  ${C4}DOTKEEP_MAX${r}  skip limit in ${c1}MiB${r}, default ${c1}10${r}, max ${c1}100${r}
               ${it}above ${b}100${r}${it} capped and warned. GitHub rejects the push${r}
EOF
}

function help::next {
  cat <<EOF
${C3}NEXT${r}
  1. ${C2}$NAME config${r}
  2. run  ${C2}$NAME backup${r}
EOF
}

function help::guide_init {
  help::howto
  help::init
}

function help::guide_empty {
  help::howto
  help::backup
  help::next
}

function help::main {
  help::intro
  help::cmds
  help::init
  help::howto
  help::layout
  help::backup
  help::restore
  help::env
}

# vim: ft=bash
