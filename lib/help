# shellcheck shell=bash disable=SC2154

function help::intro {
  cat <<EOF
${C6} dotkeep ${c7}// ${c2}dotfiles, kept simple${r}

${it}${c7}  A single plain-text manifest for syncing configuration with Git${r}
${it}${c7}  install this binary; backups live in a separate repo${r}
EOF
  ui::divider c8 ─
}

function help::init {
  cat <<EOF
${C3}INIT${r}
${C2}  $NAME init${r} [DIR]
  Creates your ${it}state dir${r}:
    ${c6}home/${r} ${c6}root/${r} + empty ${c6}$DOTCONF${r} + ${c6}.gitignore${r} + ${c2}git init${r} ${it}(if git)${r}
  ${it}Pick any other dir, then add your own remote${r}

${it}  Or skip init: mkdir a dir and write ${c6}$DOTCONF${r} yourself${r}
${it}  Next: ${C2}cd${r} to that dir, ${c2}$NAME config${r}, then ${c2}$NAME backup${r}
EOF
  ui::divider c8 -
}

function help::config {
  cat <<EOF
${C3}CONFIG${r}
${C2}  $NAME ${c2}config${r}
  Prints the full path to ${c6}$DOTCONF${r} and its contents
  Then asks to open it with ${C4}\$EDITOR${r}

  Plain file. One path per line. ${c7}#${r} comments
  Every entry must start with ${C2}home/${r} or ${C2}root/${r}
  No ${c1}~${r}, no absolute ${c1}/${r} forms, no ${c1}\$VAR${r} expansion
  Prefer explicit files over whole dirs
  Unreadable files are skipped. The rest of the dir is copied
  Backup may ${c2}chmod u+r${r} on unreadable files you own first
  Symlinks as live source skipped on backup; restore may replace a live symlink with a copy
  Nested ${c6}.git/${r} and ${c6}node_modules${r} stripped
  ${c6}.gitignore${r} pruned after backup ${it}(if git: ${c2}git clean -X${r})${r}
  Preview/check: content delta vs live FS ${it}(not git)${r};
  notes ${c3}+N ~N -N${r}; dirty → ${c2}diff${r}; identical → ${c3}same${r}

EOF
}

function help::sample {
  local -a samples=()
  mapfile -t samples <"${SCRIPT%/*}/dotkeep.conf.sample"
  view::config "$DOTCONF" "${samples[@]}"
}

function help::syntax {
  cat <<EOF
${c2}   home/.zshrc${r}       is  ${c3}\$HOME/.zshrc${r}
${c2}   root/etc/hosts${r}    is  ${c3}/etc/hosts${r}
EOF
  ui::divider c8 -
}

function help::howto {
  help::config
  help::sample
  help::syntax
}

function help::layout {
  cat <<EOF
${C3}WHERE${r}
${c2}  config${r} / ${c2}check${r} / ${c2}backup${r} / ${c2}restore${r} run inside ${it}your state dir${r}
${it}  (the dir that holds ${c6}$DOTCONF${r}). Not the tool install${r}
${it}  Any path, any remote, you choose${r}

    ${c2}state/${r}
    ${c6}├── ${c3}$DOTCONF${r}
    ${c6}├── ${c3}.gitignore${r}
    ${c6}├── home/${r}
    ${c6}└── root/${r}
EOF
  ui::divider c8 -
}

function help::backup {
  cat <<EOF
${C3}BACKUP${r}
${C2}  $NAME ${c2}backup${r}
  ${c6}1.${r} git prep ${it}(optional; skipped if no git / no .git)${r}: fetch, status, ask pull if behind
  ${c6}2.${r} preview ${c3}machine → state${r} ${it}(content delta +N ~N -N; identical dropped)${r}
  ${c6}3.${r} pick paths? ${c2}Some${r} / ${c2}All${r} ${it}(All = all diffs)${r}
     ${it}Some → multi-select, then preview selection again${r}
  ${c6}4.${r} ask before write
  ${c6}5.${r} copy listed paths into ${c6}home/${r} ${c6}root/${r}
  ${c6}6.${r} prune ignored ${it}(if git)${r} via ${c2}git clean -X${r}, rewrite ${c6}README.md${r} tree
  ${c6}7.${r} git ship ${it}(optional; if git + dirty)${r}: ask add, commit, push
  Files over ${c1}$((MAX / 1048576)) MiB${r} skipped and warned
  ${C4}DOTKEEP_MAX${r} (MiB) ${c3}default 10${r}, ${c3}max 100${r}; above ${b}100${r} capped and warned
  GitHub rejects over ${c3}100 MiB${r} on push; committed blobs still fail
  ${it}${c3}Pull, add, commit, push are opt-in.${r} Default is no. No origin → no push

  ${C6}after yes on ship${r}
    ${c2}git add -A${r}
    ${c2}git commit -m${r} ${c7}snapshot YYYY-MM-DD HH:MM${r}
    ${c2}git push${r} ${c7}# if origin exists${r}
EOF
  ui::divider c8 -
}

function help::restore {
  cat <<EOF
${C3}RESTORE${r}
  ${C2}$NAME ${c2}restore${r}
  ${c6}1.${r} same git prep as backup ${it}(optional; skipped if no git / no .git)${r}
  ${c6}2.${r} preview ${c3}state → machine${r} ${it}(content delta; identical dropped; may replace live symlink)${r}
  ${c6}3.${r} pick paths? ${c2}Some${r} / ${c2}All${r} ${it}(All = all diffs)${r}
     ${it}Some → multi-select, then preview selection again${r}
  ${c6}4.${r} ask before write
  ${c6}5.${r} live targets → ${C2}/tmp/$NAME.XXXXXX/${r} first
  ${c6}6.${r} prune ignored in state ${it}(if git)${r}, then copy ${it}(rsync --delete)${r}
  ${c6}7.${r} print safety bak path when anything was saved
  No commit or push on restore

  ${C6}new machine${r}
    ${c60}# clone your state repo${r}
    ${c2}git clone${r} ${c7}<url>${r} ${c6}<state-dir>${r}
    ${c60}# enter that clone${r}
    ${C2}cd${r} ${c6}<state-dir>${r}
    ${c60}# state → machine${r}
    ${C2}$NAME restore${r}

  ${C6}existing clone${r}
    ${c60}# enter your state dir${r}
    ${C2}cd${r} ${c6}<state-dir>${r}
    ${c60}# fetch, then pull --rebase if behind. default no${r}
    ${C2}$NAME restore${r}
EOF
  ui::divider c8 -
}

function help::cmds {
  cat <<EOF
${C3}COMMANDS${r}
  ${C2}$NAME ${c2}<command>${r}

  ${c2}init${r} [DIR]   create state dir: ${c6}home/ root/${r} + ${c6}$DOTCONF${r} + ${c6}.gitignore${r} + ${c2}git init${r} ${it}(if git)${r}
  ${c2}config${r}       show ${c6}$DOTCONF${r}, offer to edit
  ${c2}check${r}        validate paths + content delta vs state
  ${c2}backup${r}       copy live files into the state tree
  ${c2}restore${r}      copy state tree files onto the live system
  ${c2}help${r}
EOF
  ui::divider c8 -
}

function help::env {
  cat <<EOF
${C3}ENV${r}
  ${C4}NO_COLOR${r}     disables color
  ${C4}EDITOR${r}       used by ${c2}config${r}, else ${c2}nvim${r} ${c2}vim${r} ${c2}vi${r}
  ${C4}DOTKEEP_MAX${r}  skip limit in ${c1}MiB${r}, default ${c1}10${r}, max ${c1}100${r}
               ${it}above ${b}100${r}${it} capped and warned. GitHub rejects the push${r}
  ${C4}DOTKEEP_DRY${r}  ${c1}1${r} = dry-run (same as ${c2}--dry-run${r})

  ${C3}FLAGS${r} ${it}(after command)${r}
  ${c2}--dry-run${r}    rsync --dry-run; no mkdir / git writes
               ${it}e.g. ${c2}$NAME backup --dry-run${r}

  Prompts use ${c2}gum${r} (${c2}input${r}, ${c2}choose${r}, ${c2}log${r}, ${c2}style${r}, ${c2}table${r}, ${c2}pager${r})
EOF
}

function help::next {
  cat <<EOF
${C3}NEXT${r}
  1. ${C2}$NAME config${r}
  2. run  ${C2}$NAME backup${r}
EOF
}

function help::guide_init {
  help::howto
  help::init
}

function help::guide_empty {
  help::howto
  help::backup
  help::next
}

function help::main {
  local body
  body=$(
    help::intro
    help::cmds
    help::init
    help::howto
    help::layout
    help::backup
    help::restore
    help::env
  )
  ui::out "$body"
}

# vim: ft=bash
