# shellcheck shell=bash disable=SC2154

# true only when git binary exists and cwd is a work tree (.git dir or file)
function git::repo {
  command -v git >/dev/null || return 1
  [[ -d .git || -f .git ]]
}

function git::dirty {
  [[ -n "$(git status --porcelain)" ]]
}

function git::behind {
  git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' &>/dev/null || return 1
  (($(git rev-list --count 'HEAD..@{upstream}') > 0))
}

function git::rebasing {
  [[ -d .git/rebase-merge || -d .git/rebase-apply ]]
}

function git::fetch {
  git remote get-url origin &>/dev/null || return 0
  gum::spin "fetch origin" git fetch --no-progress origin || {
    ui::log warn fetch "failed, continuing local"
    return 1
  }
}

function git::pull_fail {
  local stashed=$1
  git::rebasing && git rebase --abort || :
  [[ $stashed == 1 ]] || ui::die "pull failed"
  git stash pop || ui::die "stash pop conflict"
  ui::die "pull failed"
}

function git::pull {
  local stashed=0 prompt='pull --rebase?'
  git::dirty && prompt='stash and pull --rebase?'
  ask::yn "$prompt" || {
    ui::log info pull skipped
    return 0
  }
  dry::skip "skip pull" && return 0
  git::dirty && {
    git stash push -u -m dotkeep
    stashed=1
  }
  git pull --rebase || git::pull_fail "$stashed"
  [[ $stashed == 1 ]] || return 0
  git stash pop || ui::die "stash pop conflict"
}

function git::prep {
  local fetched=0
  git::repo || return 0
  ((DRY)) || { git::fetch && fetched=1; }
  ((DRY)) && ui::log warn dry "skip fetch"
  ui::nl
  view::git
  ui::nl
  [[ $fetched == 1 ]] || return 0
  git::behind || return 0
  git::rebasing && {
    ui::log warn pull "rebase in progress"
    return 0
  }
  git::pull
}

function git::ship {
  local msg
  git::repo || return 0
  git::dirty || return 0
  ask::yn "git add -A?" || return 0
  dry::skip "skip add/commit/push" && return 0
  git add -A
  git diff --cached --quiet && {
    ui::log warn add "nothing staged"
    return 0
  }
  msg=$(ask::line "commit message" "snapshot $(date +'%Y-%m-%d %H:%M')") || {
    ui::log warn commit cancelled
    return 0
  }
  [[ $msg ]] || {
    ui::log warn commit "empty message"
    return 0
  }
  git commit -m "$msg" || {
    ui::log warn commit failed
    return 0
  }
  git remote get-url origin &>/dev/null || {
    ui::log warn push "no origin"
    return 0
  }
  ask::yn "git push?" || return 0
  git push || ui::log warn push failed
}

# vim: ft=bash
